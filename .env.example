# Supabase Dashboard > Connect > Transaction pooler (port 6543).
# Keep this value server-side only. Include sslmode=require.
DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?uselibpqcompat=true&sslmode=require
PORT=3000
NODE_ENV=development
DB_POOL_MAX=5
